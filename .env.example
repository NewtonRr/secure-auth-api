NODE_ENV=development
PORT=3000

POSTGRES_USER=auth
POSTGRES_PASSWORD=auth_dev_password
POSTGRES_DB=auth_db
DATABASE_URL=postgresql://auth:auth_dev_password@postgres:5432/auth_db

REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

TRUST_PROXY=1
